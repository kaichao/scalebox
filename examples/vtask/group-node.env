# GROUP-BOUND vtask：独立组节点（组 slot 承载）
# 与 group-bound.env 的区别：CORE_SLOTS 用组 slot 语法，在 n0-0 上建 2 个组 slot。
CLUSTER=inline
VTASK_MODE=GROUP-BOUND
# TASK_DIST_MODE 仅驱动 vtask-head 模块的平台参数（实现层枚举，勿改）
TASK_DIST_MODE=SLOT-BOUND
HEAD_SLOTS=h0:2
CORE_MODE=HOST-BOUND
# <host>:<count>:<group_prefix>：n0-0 上 2 个组 slot，领取 to_host ~ n0.+ 的 task
CORE_SLOTS=n0-0:2:n0

# GROUP-BOUND vtask：vtask 绑定节点组（head slot 锚定节点组）
CLUSTER=inline
VTASK_MODE=GROUP-BOUND
# TASK_DIST_MODE 仅驱动 vtask-head 模块的平台参数（实现层枚举，勿改）
TASK_DIST_MODE=SLOT-BOUND
# GROUP-BOUND：head→core 由脚本显式 to_host 决定；多个 core 模块之间靠相同 pod_id 保持同节点
POD_ID=vtask-pod
HEAD_SLOTS=h0:2
CORE_MODE=HOST-BOUND
CORE_SLOTS=n[01]-[01]

# vtask 容量与 wait-queue 并发（2026-11-02 L1 口径，含义见 host-bound.env）
HEAD_VTS=2
WQ_VTS=4
WQ_SLOTS=2
WQ_BATCH=1
CONTROL_NODE=h0

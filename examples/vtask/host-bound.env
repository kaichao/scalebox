# HOST-BOUND vtask：vtask 绑定单节点
CLUSTER=inline
VTASK_MODE=HOST-BOUND
# TASK_DIST_MODE 仅驱动 vtask-head 模块的平台参数（实现层枚举，勿改）
TASK_DIST_MODE=HOST-BOUND
# vtask-head/vtask-core 的 pod_id：相同值 → 下游 task 自动路由回来源节点
POD_ID=vtask-pod
HEAD_SLOTS=n0-[01]
CORE_MODE=HOST-BOUND
CORE_SLOTS=n0-[01]

# ── wait-queue 与 vtask 容量（2026-11-02 L1 口径）─────────────────
#   HEAD_VTS  = vtask-head 的 vtask_size，即**每 host** 在制 vtask 上限
#   全部空额  = host 数 x HEAD_VTS（本文件 2 host x 2 = 4）
#   WQ_VTS    = wait-queue 的并发 bind 准入总量，取"全部空额"
#   WQ_SLOTS  = wait-queue 的 slot 数（并发 bind 度），**必须 <= WQ_VTS**
#   WQ_BATCH  = 每 slot 一次领取的任务数；**WQ_SLOTS x WQ_BATCH <= WQ_VTS**
#               （agent 对一批仍串行执行，批量只摊薄 RPC，不改变并发度）
# 扩节点/扩容量时这四个值一起放大
HEAD_VTS=2
WQ_VTS=4
WQ_SLOTS=2
WQ_BATCH=1

# wait-queue 落控制机（原 slot_on_head 的效果；显式 slots 才能配多实例）
CONTROL_NODE=h0

# scalebox.env 基线里是 60；这里覆盖成 1 秒，core 真正执行时长
RUNNING_SECONDS=1
